<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.biz.purchase.mapper.BizPurchaseOrderMapper">

    <!-- 不过滤 del_flag：已删除单据占用的单号也不能再次分配 -->
    <select id="selectMaxOrderNoByPrefix" resultType="java.lang.String">
        select order_no
        from biz_purchase_order
        where order_no like concat(#{prefix}, '%')
        order by length(order_no) desc, order_no desc
        limit 1
    </select>

</mapper>
